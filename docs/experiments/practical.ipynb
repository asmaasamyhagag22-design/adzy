   "source": [
    "def average (List:list)-> float:\n",
    "    i=0\n",
    "    sum=0\n",
    "\n",
    "    for i in range (len(List)):\n",
    "        sum += List[i]\n",
    "    print(sum)\n",
    "    return sum / len(List)"
   ]
  },
