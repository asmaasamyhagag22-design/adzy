# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Secrets — CRITICAL: never commit API keys.
# The API reads OPENAI_API_KEY from .env; without this line a single
# `git add .` could leak the key into history.
.env
.env.*
*.key

# Scrape outputs (large, regeneratable)
scrapes/
benchmark/summary.csv
benchmark/runs/

# Poster outputs (~140 MB of generated PNGs; regeneratable from profiles).
# Force-add specific keepers with `git add -f` — e.g. the reusable Imagen
# backgrounds in outputs/posters/backgrounds/ that process.md marks reusable.
outputs/

# Cloud-sync and OS artifacts (Google Drive / OneDrive / macOS)
desktop.ini
.DS_Store
Thumbs.db

# Archives and packed snapshots (don't commit zipped copies of the repo)
*.zip
*.tar
*.tar.gz
repomix.config.json.txt
project_light.zip

# Sync-conflict duplicates (e.g. "graders (1).py")
*\ (1).*
*\ (2).*
* copy.*

# Local scratch / diagnostics (move keepers into tools/ or scripts/).
# ANCHORED to the repo root on purpose: unanchored, `verify_*.py` also swallowed
# `scripts/verify_meta_token.py`, so two committed tests imported a module git was
# silently refusing to track. Keepers under scripts/ and tools/ are now tracked,
# which is what the line above always meant.
/inspect_*.py
/verify_*.py
api_*.json
*_diagnostic.txt
error_log.txt
error.txt
output.txt
candidate_check.txt
phone_diagnostic.txt

# Local assistant/editor tooling folder (machine-specific; keep out of the repo)
.claude/

# IDE
.vscode/
.idea/
*.swp

# Stray generated artifacts at the repo root (the real outputs live in outputs/;
# these are stray root copies, audit sidecars, and scratch data dumps). Committed
# measurement-corpus profiles (te_eg_gemini.json, iti_home*.json, *_real.json,
# marasim_profile.json) are added explicitly and are NOT covered by these.
/poster_*.png
/*_poster.png
/*.audit.json
/project_structure.txt
/profile.json
/profile_buf.json
/elkbabgi_profile_fresh.json
/_prompt_diag.py
# U7 telemetry run-records (JSONL per pipeline run)
runs/

# team facebook collector: RAW outputs carry unhashed author names (PII) — never commit;
# the code enters the pipeline only wrapped as social_intel/providers/apify_facebook.py
facebook_collector/*.json
facebook_collector/__pycache__/

# logs/ product (Phase 0): track the markdown, not the per-run render artifacts
logs/*/

# competitor registry — per-machine baseline state, like runs/
registry/

# P-92: stray reel sound-bed / TTS scratch artifacts at the repo root (a bare out-path used to
# leak `x.wav` here). The tests now write under tmp_path; this is a belt-and-suspenders net.
/x.wav
/*.bed.m4a
/*.vo.m4a

# stray scratch outputs (were committed by accident)
/out.wav
/x.mp3
/image-*.png
