# Copy to .env and fill in only what you intend to use.
# Nothing here is required to run the test suite — it is hermetic and blocks the network.

# ---------------------------------------------------------------------------
# Google / Vertex AI — text, image and video generation
# ---------------------------------------------------------------------------
# Vertex path (preferred): authenticate with `gcloud auth application-default login`,
# then set the project. No key goes in this file.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Direct API path instead of Vertex (either one, not both)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Media generation
# ---------------------------------------------------------------------------
REEL_VIDEO_MODEL=veo-3.1-generate-001
ONESHOT_IMAGE_MODEL=gemini-2.5-flash-image

# Voice-over
REEL_TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=
REEL_ELEVENLABS_VOICE=

# ---------------------------------------------------------------------------
# Spend guards — these are ceilings, not budgets. Generation stops at them.
# ---------------------------------------------------------------------------
VERTEX_MONTHLY_CAP_USD=50
VEO_MAX_USD_PER_RUN=12
VEO_USD_PER_SEC=0.40
# Set to 1 to hard-block every paid call (useful for demos and dry runs).
BASEERA_NO_SPEND=0

# ---------------------------------------------------------------------------
# Search and competitor discovery
# ---------------------------------------------------------------------------
SERPER_API_KEY=
SERPER_MONTHLY_CALL_CAP=2000
GOOGLE_MAPS_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------------------
# Meta / Instagram — competitor live-ad intelligence and social collection
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ADS_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
SCRAPER_ACCEPT_LANGUAGE=ar,en;q=0.8

# ---------------------------------------------------------------------------
# Test-suite escape hatches — leave unset in normal use
# ---------------------------------------------------------------------------
# PYTEST_ALLOW_NETWORK=1   # lets a test reach the network; off by default on purpose
# RUN_LIVE_GATES=1         # runs the gates that call real providers
